{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"parallel": 8,
	"namedInputs": {
		"sharedGlobals": [
			"{workspaceRoot}/.oxfmtrc.json",
			"{workspaceRoot}/pnpm-workspace.yaml",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/packages/configs/tsconfig.json"
		],
		"default": ["{projectRoot}/**/*", "sharedGlobals"]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"{projectRoot}/package.json",
				"{projectRoot}/tsconfig.json",
				"{projectRoot}/tsdown.config.ts",
				"{projectRoot}/src/**"
			],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": true
		},
		"lint": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"release": {
			"dependsOn": ["^release"],
			"cache": false
		},
		"scan": {
			"inputs": ["{projectRoot}/package.json"],
			"outputs": ["{projectRoot}/*.tgz"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"{projectRoot}/package.json",
				"{projectRoot}/tsconfig.json",
				"{projectRoot}/src/**",
				"{projectRoot}/test/**"
			],
			"cache": true
		}
	},
	"release": {
		"projects": ["packages/*"],
		"projectsRelationship": "independent",
		"versionPlans": {
			"ignorePatternsForPlanCheck": ["**/*.test.ts", "eslint.config.js"]
		},
		"releaseTag": {
			"requireSemver": true,
			"strictPreid": true
		},
		"changelog": {
			"workspaceChangelog": {
				"createRelease": "github"
			}
		}
	},
	"analytics": false
}
