{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"parallel": 8,
	"namedInputs": {
		"sharedGlobals": [
			"{workspaceRoot}/.oxfmtrc.json",
			"{workspaceRoot}/pnpm-workspace.yaml",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/packages/configs/tsconfig.json"
		],
		"default": ["{projectRoot}/**/*", "sharedGlobals"]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"{projectRoot}/package.json",
				"{projectRoot}/tsconfig.json",
				"{projectRoot}/tsdown.config.ts",
				"{projectRoot}/src/**"
			],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": true
		},
		"lint": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"release": {
			"dependsOn": ["^release"],
			"cache": false
		},
		"scan": {
			"inputs": ["{projectRoot}/package.json"],
			"outputs": ["{projectRoot}/*.tgz"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"{projectRoot}/package.json",
				"{projectRoot}/tsconfig.json",
				"{projectRoot}/src/**",
				"{projectRoot}/test/**"
			],
			"cache": true
		}
	},
	"release": {
		"versionPlans": {
			"ignorePatternsForPlanCheck": ["**/*.test.ts", "**/test/**", "**/oxlint.config.ts"]
		},
		"version": {
			"git": { "commit": true, "tag": true },
			"updateDependents": "never"
		},
		"releaseTag": {
			"requireSemver": true,
			"strictPreid": true
		},
		"groups": {
			"solarwinds-apm": {
				"projects": ["packages/*", "!@solarwinds-apm/instrumentations"],
				"projectsRelationship": "fixed",
				"releaseTag": {
					"pattern": "v{version}"
				},
				"changelog": {
					"createRelease": false,
					"entryWhenNoChanges": false
				}
			},
			"instrumentations": {
				"projects": ["@solarwinds-apm/instrumentations"],
				"projectsRelationship": "fixed",
				"releaseTag": {
					"pattern": "instrumentations-{version}"
				},
				"changelog": {
					"createRelease": false,
					"entryWhenNoChanges": false
				}
			}
		}
	},
	"analytics": false
}
