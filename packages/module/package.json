{
	"name": "@solarwinds-apm/module",
	"version": "17.0.0-pre.0",
	"license": "Apache-2.0",
	"contributors": [
		"Raphaël Thériault <raphael.theriault@solarwinds.com>"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/solarwinds/apm-js.git",
		"directory": "packages/module"
	},
	"files": [
		"./src/",
		"./dist/"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown && oxfmt package.json",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"lint:fix": "oxlint --fix && oxfmt",
		"release": "node ../../scripts/publish.js",
		"scan": "node ../../scripts/scan.js"
	},
	"devDependencies": {
		"@solarwinds-apm/configs": "workspace:^",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
