{
	"name": "@solarwinds-apm/dependencies",
	"version": "2.0.2",
	"license": "Apache-2.0",
	"contributors": [
		"Raphaël Thériault <raphael.theriault@solarwinds.com>"
	],
	"files": [
		"./src/",
		"./dist/"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown && oxfmt package.json",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"lint:fix": "oxlint --fix && oxfmt",
		"release": "node ../../scripts/publish.js",
		"scan": "node ../../scripts/scan.js",
		"test": "swtest -p test/tsconfig.json -c src"
	},
	"devDependencies": {
		"@solarwinds-apm/configs": "workspace:^",
		"@solarwinds-apm/test": "workspace:^",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
