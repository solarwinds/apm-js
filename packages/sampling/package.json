{
	"name": "@solarwinds-apm/sampling",
	"version": "3.2.1",
	"license": "Apache-2.0",
	"contributors": [
		"Raphaël Thériault <raphael.theriault@solarwinds.com>"
	],
	"files": [
		"./src/",
		"./dist/"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown && oxfmt package.json",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"lint:fix": "oxlint --fix && oxfmt",
		"release": "node ../../scripts/publish.js",
		"scan": "node ../../scripts/scan.js",
		"test": "swtest -c src"
	},
	"dependencies": {
		"@opentelemetry/sdk-trace": "catalog:"
	},
	"devDependencies": {
		"@noble/hashes": "^2.4.0",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/sdk-metrics": "catalog:",
		"@solarwinds-apm/configs": "workspace:^",
		"@solarwinds-apm/module": "workspace:^",
		"@solarwinds-apm/test": "workspace:^",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@opentelemetry/api": "catalog:"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/api": {
			"optional": false
		}
	}
}
